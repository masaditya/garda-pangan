---
import BaseLayout from '#/layouts/BaseLayout.astro'
import { ProgramListSection } from '#/components/program-list-section'
import {
  getLangStaticPaths,
  getMessages,
  localizedPath,
  resolveLocale,
} from '#/lib/i18n'
import { normalizeStrapiMediaUrl } from '#/lib/strapi/client'
import { getProgramPage } from '#/lib/strapi/program-page'
import {
  formatProgramDescription,
  getProgramThumbnailUrl,
  getPrograms,
  mapProgramToDetailButtons,
} from '#/lib/strapi/programs'

export function getStaticPaths() {
  return getLangStaticPaths()
}

const locale = resolveLocale(Astro.params.lang)
const messages = getMessages(locale)

const pageResponse = await getProgramPage({ locale })
const pageData = pageResponse.data ?? {
  title: messages.program.heroTitle,
  description: messages.program.heroDescription,
  backgroundImage: null,
}

const heroTitle = pageData.title ?? messages.program.heroTitle
const heroDescription = pageData.description ?? messages.program.heroDescription
const heroBackground = normalizeStrapiMediaUrl(pageData.backgroundImage?.url)

const programs = await getPrograms({ locale })

const programItems = programs.map((program) => ({
  title: program.title,
  image: getProgramThumbnailUrl(program.thumbnail),
  description: formatProgramDescription(program.description),
  buttons: mapProgramToDetailButtons(program, locale),
}))
---

<BaseLayout
  locale={locale}
  title={messages.program.pageTitle}
  description={messages.program.pageDescription}
  canonicalPath={localizedPath('/program', locale)}
>
  <main class="garda-main">
    <ProgramListSection
      client:load
      title={heroTitle}
      description={heroDescription}
      moreLabel={messages.program.moreLabel}
      backgroundImage={heroBackground}
      programs={programItems}
      locale={locale}
    />
  </main>
</BaseLayout>

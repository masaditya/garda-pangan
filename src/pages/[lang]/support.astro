---
import BaseLayout from '#/layouts/BaseLayout.astro'
import { SupportSection } from '#/components/support-section'
import {
  getLangStaticPaths,
  getMessages,
  localizedPath,
  resolveLocale,
} from '#/lib/i18n'
import { getSupportPage } from '#/lib/strapi/pages'
import { normalizeStrapiMediaUrl } from '#/lib/strapi/client'

export function getStaticPaths() {
  return getLangStaticPaths()
}

const locale = resolveLocale(Astro.params.lang)
const messages = getMessages(locale)

const supportPageResponse = await getSupportPage({ locale })
const supportPageData = supportPageResponse?.data
const titleLine1 = supportPageData?.heroTitleLine1 || messages.support.titleLine1
const titleLine2 = supportPageData?.heroTitleLine2 || messages.support.titleLine2
const description = supportPageData?.heroIntro || messages.support.description
const qrisCaption = supportPageData?.caption || messages.support.caption
const qrisImageSrc =
  normalizeStrapiMediaUrl(supportPageData?.paymentQris?.url) ||
  messages.support.qrisImageSrc
const bgImage = normalizeStrapiMediaUrl(supportPageData?.heroBackground?.url)
---

<BaseLayout
  locale={locale}
  title={messages.support.pageTitle}
  description={messages.support.pageDescription}
  canonicalPath={localizedPath('/support', locale)}
>
  <main class="relative isolate min-h-screen">
    <div
      class="absolute inset-0 -z-20 bg-cover bg-fixed bg-center"
      style={`background-image: url(${bgImage})`}
    >
    </div>
    <div class="absolute inset-0 -z-10 bg-[#0C381E]/75 mix-blend-multiply">
    </div>
    <div
      class="absolute inset-x-0 top-0 -z-10 h-[50vh] bg-linear-to-b from-[#0C381E]/60 to-transparent"
    >
    </div>

    <div class="relative z-10 w-full">
      <SupportSection
        client:load
        titleLine1={titleLine1}
        titleLine2={titleLine2}
        description={description}
        qrisImageSrc={qrisImageSrc}
        caption={qrisCaption}
      />
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '#/layouts/BaseLayout.astro'
import { VolunteerSection } from '#/components/volunteer-section'
import {
  getLangStaticPaths,
  getMessages,
  localizedPath,
  resolveLocale,
} from '#/lib/i18n'
import {
  getHeroBackgroundUrl,
  getRelawanPage,
} from '#/lib/strapi/relawan'

export function getStaticPaths() {
  return getLangStaticPaths()
}

const locale = resolveLocale(Astro.params.lang)
const messages = getMessages(locale)

const relawanPage = await getRelawanPage({ locale })
const pageData = relawanPage.data

const heroTitle = pageData?.heroTitle ?? ''
const titleWords = heroTitle.split(' ')
const midPoint = Math.ceil(titleWords.length / 2)

const titleLine1 =
  pageData?.heroTitle ? titleWords.slice(0, midPoint).join(' ') : messages.volunteer.titleLine1
const titleLine2 =
  pageData?.heroTitle ? titleWords.slice(midPoint).join(' ') : messages.volunteer.titleLine2
const description = pageData?.heroSubtitle ?? messages.volunteer.description
const cta = pageData?.buttonText ?? messages.volunteer.cta
const ctaLink = pageData?.buttonLink ?? '#'
const backgroundImage = pageData?.heroBackground
  ? getHeroBackgroundUrl(pageData.heroBackground)
  : null
---

<BaseLayout
  locale={locale}
  title={messages.volunteer.pageTitle}
  description={messages.volunteer.pageDescription}
  canonicalPath={localizedPath('/relawan', locale)}
>
  <main class="relative isolate min-h-screen">
    <div class="relative z-10 w-full">
      <VolunteerSection
        client:load
        titleLine1={titleLine1}
        titleLine2={titleLine2}
        description={description}
        cta={cta}
        ctaLink={ctaLink}
        backgroundImage={backgroundImage}
      />
    </div>
  </main>
</BaseLayout>
